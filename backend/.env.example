# Used only for local development. Production uses Lambda environment variables.
STORAGE=local
JWT_SECRET=podimart-dev-secret-change-in-production
AWS_REGION=ap-south-1
# After AWS deploy, add the CloudFront URLs (default AWS DNS is enough):
# CORS_ORIGINS=http://localhost:5173,https://dBuyerxxxx.cloudfront.net,https://dSellerxxxx.cloudfront.net

# --- Email via Amazon SES (recommended — you already verified podimart.lk) ---
# Uses the AWS credential chain (env keys, ~/.aws/credentials, or IAM role on Lambda).
EMAIL_PROVIDER=ses
SMTP_FROM=podimart.lk <no-reply@podimart.lk>
# Domain podimart.lk must be verified in SES (you already did this).
# With production access you can send to any seller email — no per-recipient verify needed.

# --- Or email via SES SMTP instead of the API ---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=  # from SES → SMTP settings → Create SMTP credentials
# SMTP_PASSWORD=
# SMTP_FROM=podimart.lk <no-reply@podimart.lk>

# WhatsApp Cloud API — messages come FROM the podimart.lk Business number.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=new_order
# WHATSAPP_TEMPLATE_LANG=en
